@page "/availability"
@using BookItLite.Data
@using BookItLite.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using BookItLite.Services
@attribute [Authorize(Roles = "Provider")]
@inject ApplicationDbContext Db
@inject TimeZoneService TimeZone
@rendermode InteractiveServer

<PageTitle>Availability</PageTitle>

<h1>Schedule availability</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

<div class="form-card">
    <EditForm Model="slotForm" OnValidSubmit="SaveSlotAsync">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Service</label>
                <InputSelect class="form-select" @bind-Value="slotForm.ServiceId">
                    <option value="0">Select a service</option>
                    @foreach (var service in services)
                    {
                        <option value="@service.Id">@service.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Start</label>
                <InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="slotForm.StartUtc" />
            </div>
            <div class="col-md-4">
                <label class="form-label">End</label>
                <InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="slotForm.EndUtc" />
            </div>
        </div>

        <button class="btn btn-primary mt-3" type="submit">Add availability</button>
    </EditForm>
</div>

<div class="mt-4">
    <h3>Available time slots</h3>

    @if (!availability.Any())
    {
        <p class="text-muted">No time slots available yet.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>When</th>
                    <th>Notes</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in availability)
                {
                    <tr>
                        <td>@slot.BookingService.Name</td>
                        <td>@TimeZone.ToLocal(slot.StartUtc).ToString("ddd, MMM d")<br />@TimeZone.ToLocal(slot.StartUtc).ToString("h:mm tt") - @TimeZone.ToLocal(slot.EndUtc).ToString("h:mm tt")</td>
                        <td>@(string.IsNullOrWhiteSpace(slot.Notes) ? "Standard opening" : slot.Notes)</td>
                        <td>
                            @if (slot.IsBooked)
                            {
                                <span class="badge bg-danger">Booked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteSlotAsync(slot.Id)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<BookingService> services = new();
    private List<AvailabilitySlot> availability = new();
    private SlotFormModel slotForm = new();
    private string? message;

    private void ResetSlotForm()
    {
        var tomorrow = TimeZone.ToLocal(DateTime.UtcNow).Date.AddDays(1);

        slotForm = new SlotFormModel
        {
            StartUtc = tomorrow.AddHours(9),
            EndUtc = tomorrow.AddHours(10)
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TimeZone.InitializeAsync();

            ResetSlotForm();

            await LoadAsync();

            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        services = await Db.BookingServices
            .Where(s => s.IsActive)
            .OrderBy(s => s.Name)
            .ToListAsync();

        availability = await Db.AvailabilitySlots
            .Include(s => s.BookingService)
            .OrderByDescending(s => s.StartUtc)
            .ToListAsync();
    }

 
    private async Task SaveSlotAsync()
    {
        if (slotForm.ServiceId == 0)
        {
            message = "Please select a service.";
            return;
        }

        if (slotForm.StartUtc >= slotForm.EndUtc)
        {
            message = "The end time must be later than the start time.";
            return;
        }

        var service = await Db.BookingServices.FindAsync(slotForm.ServiceId);

        if (service is null)
        {
            message = "The selected service was not found.";
            return;
        }
        var startUtc = TimeZone.ToUtc(slotForm.StartUtc);
        var endUtc = TimeZone.ToUtc(slotForm.EndUtc);

        var conflictExists = await Db.AvailabilitySlots.AnyAsync(slot =>
            slot.BookingServiceId == slotForm.ServiceId &&
            slot.StartUtc < endUtc &&
            slot.EndUtc > startUtc
        );

        if (conflictExists)
        {
            message = "This time slot overlaps with an existing availability. Please select another time.";
            return;
        }

        var slot = new AvailabilitySlot
        {
            BookingServiceId = service.Id,
            StartUtc = startUtc,
            EndUtc = endUtc,
            Notes = "Provider-managed slot"
        };

        Db.AvailabilitySlots.Add(slot);

        await Db.SaveChangesAsync();

        message = $"Availability added successfully for {service.Name}.";

        ResetSlotForm();

        await LoadAsync();
    }


    private async Task DeleteSlotAsync(int id)
    {
        var slot = await Db.AvailabilitySlots.FindAsync(id);

        if (slot is null)
        {
            message = "Availability slot not found.";
            return;
        }

        var hasActiveAppointment = await Db.Appointments.AnyAsync(a =>
            a.AvailabilitySlotId == id &&
            (a.Status == AppointmentStatus.Pending ||
            a.Status == AppointmentStatus.Confirmed));

        if (slot.IsBooked || hasActiveAppointment)
        {
            message = "This slot cannot be removed because it has an active appointment. Cancel the appointment first.";
            return;
        }

        Db.AvailabilitySlots.Remove(slot);

        await Db.SaveChangesAsync();

        message = "The slot was removed.";

        await LoadAsync();
    }

    private sealed class SlotFormModel
    {
        public int ServiceId { get; set; }
        public DateTime StartUtc { get; set; } = DateTime.UtcNow.AddDays(1).Date.AddHours(9);
        public DateTime EndUtc { get; set; } = DateTime.UtcNow.AddDays(1).Date.AddHours(10);
    }
}

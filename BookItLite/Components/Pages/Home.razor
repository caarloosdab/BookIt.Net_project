@page "/"
@using BookItLite.Data
@using BookItLite.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>BookIt Lite</PageTitle>

<div class="hero-panel">
    <div>
        <p class="eyebrow">Smart scheduling for small businesses</p>
        <h1>BookIt Lite</h1>
        <p class="lead">Keep your services organized, prevent double bookings, and help customers schedule with confidence.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" href="/appointments">Book now</a>
            <a class="btn btn-outline-primary" href="/services">Manage services</a>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-label">Services</div>
            <div class="card-value">@serviceCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-label">Open slots</div>
            <div class="card-value">@slotCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-label">Appointments</div>
            <div class="card-value">@appointmentCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card">
            <div class="card-label">Status</div>
            <div class="card-value">Live</div>
        </div>
    </div>
</div>

<div class="mt-4 row g-4">
    <div class="col-lg-8">
        <div class="panel-box">
            <h3>Upcoming bookings</h3>
            @if (!upcomingAppointments.Any())
            {
                <p class="text-muted mb-0">No appointments scheduled yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var appointment in upcomingAppointments)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@appointment.BookingService.Name</strong><br />
                                <small>@appointment.CustomerName · @appointment.StartUtc.ToString("ddd, MMM d")</small>
                            </div>
                            <span class="badge text-bg-primary">@appointment.StartUtc.ToString("h:mm tt")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel-box">
            <h3>Included features</h3>
            <ul class="feature-list">
                <li>Service catalog management</li>
                <li>Availability creation and tracking</li>
                <li>Appointment booking with conflict checks</li>
                <li>Customer and provider workflows</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private int serviceCount;
    private int slotCount;
    private int appointmentCount;
    private List<Appointment> upcomingAppointments = new();

    protected override async Task OnInitializedAsync()
    {
        serviceCount = await Db.BookingServices.CountAsync();
        slotCount = await Db.AvailabilitySlots.CountAsync();
        appointmentCount = await Db.Appointments.CountAsync();

        upcomingAppointments = await Db.Appointments
            .Include(a => a.BookingService)
            .Where(a => a.StartUtc >= DateTime.UtcNow)
            .OrderBy(a => a.StartUtc)
            .Take(5)
            .ToListAsync();
    }
}

@page "/services"
@using BookItLite.Data
@using BookItLite.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Provider")]
@inject ApplicationDbContext Db
@rendermode InteractiveServer

<PageTitle>Services</PageTitle>

<h1>Service catalog</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success mt-3">@message</div>
}

<div class="form-card">
    <EditForm Model="form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Service name</label>
                <InputText class="form-control" @bind-Value="form.Name" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Duration (minutes)</label>
                <InputNumber class="form-control" @bind-Value="form.DurationMinutes" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Price</label>
                <InputNumber class="form-control" @bind-Value="form.Price" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="form.Description" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save service</button>
            @if (form.Id > 0)
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Cancel</button>
            }
        </div>
    </EditForm>
</div>

<div class="mt-4">
    <h3>Current services</h3>

    @if (!services.Any())
    {
        <p class="text-muted">No services yet. Add your first offering above.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Duration</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in services)
                {
                    <tr>
                        <td>
                            <strong>@service.Name</strong><br />
                            <small>@service.Description</small>
                        </td>
                        <td>@service.DurationMinutes min</td>
                        <td>$@service.Price</td>
                        <td>@(service.IsActive ? "Active" : "Hidden")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-2" type="button" @onclick="() => EditService(service)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeleteService(service.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<BookingService> services = new();
    private BookingService form = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadServicesAsync();
    }

    private async Task LoadServicesAsync()
    {
        services = await Db.BookingServices
            .OrderBy(s => s.Name)
            .ToListAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            message = "Service name is required.";
            return;
        }

        if (form.Id == 0)
        {
            Db.BookingServices.Add(form);
            message = "Service created successfully.";
        }
        else
        {
            var existing = await Db.BookingServices.FindAsync(form.Id);
            if (existing is null)
            {
                message = "The selected service could not be found.";
                return;
            }

            existing.Name = form.Name;
            existing.Description = form.Description;
            existing.DurationMinutes = form.DurationMinutes;
            existing.Price = form.Price;
            existing.IsActive = form.IsActive;
            message = "Service updated successfully.";
        }

        await Db.SaveChangesAsync();
        form = new BookingService();
        await LoadServicesAsync();
    }

    private void EditService(BookingService service)
    {
        form = new BookingService
        {
            Id = service.Id,
            Name = service.Name,
            Description = service.Description,
            DurationMinutes = service.DurationMinutes,
            Price = service.Price,
            IsActive = service.IsActive
        };
        message = null;
    }

    private async Task DeleteService(int id)
    {
        var service = await Db.BookingServices
            .Include(s => s.AvailabilitySlots)
            .Include(s => s.Appointments)
            .FirstOrDefaultAsync(s => s.Id == id);

        if (service is null)
        {
            return;
        }

        Db.BookingServices.Remove(service);
        await Db.SaveChangesAsync();
        form = new BookingService();
        message = "Service removed.";
        await LoadServicesAsync();
    }

    private void ResetForm()
    {
        form = new BookingService();
        message = null;
    }
}
